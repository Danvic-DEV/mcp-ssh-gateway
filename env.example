# mcp-ssh-gateway Configuration
# Copy this file to .env and update with your values

# SSH Server Configuration
SSH_HOST=your-server.example.com
SSH_USER=root
SSH_PASSWORD=your_password_here
# OR use SSH key instead of password:
SSH_KEY_FILE=/app/ssh_keys/id_ed25519
SSH_PORT=22

# Optional MCP API authentication token.
# If set, requests must include: Authorization: Bearer <token>
# AUTH_TOKEN=your_secure_random_token

# OAuth 2.0 client credentials for requesting AUTH_TOKEN at /oauth/token
# CLIENT_ID=your_client_id
# CLIENT_SECRET=your_client_secret
# Optional external base URL used in OAuth metadata responses
# SERVER_URL=https://mcp-ssh-gateway.example.com

# Server Configuration (optional)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Hardening (all optional; unset = original behaviour)
# TOOL_PROFILE=readonly        # only fixed read-only tools; no execute_command
# ENABLED_TOOLS=get_server_info,check_port
# ALLOWED_HOSTS=10.0.0.5,host02
# SCRUB_OUTPUT=true            # mask token-like strings in tool output
# REQUIRE_AUTH=true            # refuse to start without AUTH_TOKEN
